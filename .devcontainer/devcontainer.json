{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": ["-p", "4133:4133"],
    "mounts": [
        {
            "source": "${localWorkspaceFolder}",
            "target": "/src",
            "type": "bind"
        }
    ],
    "forwardPorts": [4133],
    "postCreateCommand": "cd lobby && npm install",
    "postStartCommand": "opencode service set hostname 0.0.0.0 && opencode service set port 4133 && opencode service start"
}
